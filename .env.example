# Supabase wiring for the JUO campaign rebuild.
# Project: JUO (ref xxljlhgjjirewkovuzif, eu-west-1)
# Do not commit real keys. Set these in Vercel project settings.
# Required for POST /api/join and POST /api/contact (503 if missing).

NEXT_PUBLIC_SUPABASE_URL=https://xxljlhgjjirewkovuzif.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set on Vercel Production to enable GA4 (e.g. G-XXXXXXXX). Unset = no gtag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Google Search Console HTML-tag token (content= value only).
# Unset or blank = no google-site-verification meta. Set on Vercel Production
# after copying the token from Search Console → HTML tag, then redeploy.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server only (never NEXT_PUBLIC). SMTP for the /contact auto reply (IVA-47),
# sent from campaign@votejohnupanodey.com via the Hostinger mailbox.
# Unset = submissions still save; the auto reply is skipped and logged.
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (default). 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=campaign@votejohnupanodey.com
SMTP_PASS=
